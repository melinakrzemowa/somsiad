<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melinakrzemowa.somsiad-updates</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/kelu/services/monitoring.melinakrzemowa.pl/scripts/updates_textfile.py</string>
  </array>

  <!-- softwareupdate hits Apple's servers and takes ~a minute; every 6h is plenty. -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/kelu/services/monitoring.melinakrzemowa.pl/scripts/updates_textfile.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kelu/services/monitoring.melinakrzemowa.pl/scripts/updates_textfile.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
