# Copy to .env on the Air at /Users/kelu/services/monitoring.melinakrzemowa.pl/.env
# .env is gitignored — never commit real secrets.

# Image tag for the somsiad-config image, set by CI (sed-replaced on deploy).
VERSION=latest

# Grafana admin login. Cloudflare Access is the primary authn — this is the fallback.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Public URL — must match the Cloudflare Tunnel hostname.
GF_SERVER_ROOT_URL=https://monitoring.melinakrzemowa.pl

# SMTP for alert emails. The values below are placeholders — fill from password manager.
SMTP_HOST=h18.seohost.pl
SMTP_PORT=465
SMTP_USER=alert@melinakrzemowa.pl
SMTP_PASSWORD=fill-me-in
SMTP_FROM_ADDRESS=alert@melinakrzemowa.pl
SMTP_FROM_NAME=somsiad

# Comma-separated list of who receives alerts.
ALERT_EMAIL_TO=kelostrada@gmail.com
