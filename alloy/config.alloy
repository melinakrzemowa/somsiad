// =============================================================================
// LOGS — discover all docker containers and ship their stdout/stderr to Loki
// =============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Drop our own monitoring containers from log collection (they're noisy and
  // we'd be storing their logs in Loki, which generates more logs, etc.)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(grafana|prometheus|loki|tempo|alloy)"
    action        = "drop"
  }

  // Use the container name (minus leading /) as the loki "container" label.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Best-effort: tag a 'service' label by stripping the docker-compose suffix.
  // e.g. instamelinakrzemowapl-web-1 -> instagrain
  //      sribiamelinakrzemowapl-db-1 -> sribia-db
  //      mooncraft -> mooncraft
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-web-.*"
    target_label  = "service"
    replacement   = "instagrain"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-db-.*"
    target_label  = "service"
    replacement   = "instagrain-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-minio.*"
    target_label  = "service"
    replacement   = "instagrain-minio"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/sribia.*-web-.*"
    target_label  = "service"
    replacement   = "sribia"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/sribia.*-db-.*"
    target_label  = "service"
    replacement   = "sribia-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/mooncraft"
    target_label  = "service"
    replacement   = "mooncraft"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/abyss"
    target_label  = "service"
    replacement   = "abyss"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-web-.*"
    target_label  = "service"
    replacement   = "fossil"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-db-.*"
    target_label  = "service"
    replacement   = "fossil-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-cron-.*"
    target_label  = "service"
    replacement   = "fossil-cron"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/depot.*-web-.*"
    target_label  = "service"
    replacement   = "depot"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/depot.*-db-.*"
    target_label  = "service"
    replacement   = "depot-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/depot.*-cron-.*"
    target_label  = "service"
    replacement   = "depot-cron"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/dice.*-web-.*"
    target_label  = "service"
    replacement   = "dice"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/dice.*-db-.*"
    target_label  = "service"
    replacement   = "dice-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/apikelostradapl-web-.*"
    target_label  = "service"
    replacement   = "api"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/blog-wakacjekelostradapl-web-.*"
    target_label  = "service"
    replacement   = "blog-wakacje"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/melinakrzemowapl-web-.*"
    target_label  = "service"
    replacement   = "melinakrzemowa"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/kelostradapl-web-.*"
    target_label  = "service"
    replacement   = "kelostrada"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/kelostradapl-db-.*"
    target_label  = "service"
    replacement   = "kelostrada-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/kelostradapl-cron-.*"
    target_label  = "service"
    replacement   = "kelostrada-cron"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/tibiantisnet-web-.*"
    target_label  = "service"
    replacement   = "tibiantis"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/tibiantisnet-db-.*"
    target_label  = "service"
    replacement   = "tibiantis-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/cardfightpl-web-.*"
    target_label  = "service"
    replacement   = "cardfight"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/cardfightpl-db-.*"
    target_label  = "service"
    replacement   = "cardfight-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/photoskelostradapl-museum-.*"
    target_label  = "service"
    replacement   = "ente-museum"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/photoskelostradapl-web-.*"
    target_label  = "service"
    replacement   = "ente-web"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/photoskelostradapl-postgres-.*"
    target_label  = "service"
    replacement   = "ente-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/photoskelostradapl-minio-.*"
    target_label  = "service"
    replacement   = "ente-minio"
  }
  // aniasienudzi (compose project `ania`). ania-app-* also matches the
  // migrate one-off that each deploy runs (ania-app-run-*). The same names
  // label docker_container_info for cAdvisor joins (prometheus.yml).
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/ania-app-.*"
    target_label  = "service"
    replacement   = "aniasienudzi"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/ania-db-.*"
    target_label  = "service"
    replacement   = "aniasienudzi-db"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
  refresh_interval = "30s"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// =============================================================================
// TRACES — receive OTLP from apps, batch, ship to Tempo
// =============================================================================

otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// =============================================================================
// METRICS — Blackbox (HTTP probes). Per-container metrics come from a
// dedicated cAdvisor service (see docker-compose.yml); Prometheus scrapes
// it directly via its own scrape_config.
// =============================================================================

prometheus.exporter.blackbox "public_http" {
  // Every target lives on this host behind the Cloudflare tunnel; http_2xx
  // is the lenient module for plain sites. The somsiad-blackbox User-Agent
  // (both modules) matches a Cloudflare WAF skip rule, so probes bypass the
  // bot challenge and reach the origin — without it a challenged probe gets
  // an edge-served 403 and never tests the site at all (see the
  // ProbeChallenged alert). 401/403 stay in http_2xx's valid list for
  // anything later put behind Cloudflare Access.
  //
  // http_ready is for readiness endpoints: only a 200 whose body says
  // "status":"ok" passes, so a 503 (database down, migrations pending), an
  // edge-served 403 or a redirect to a login page all count as down.
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { preferred_ip_protocol: ip4, fail_if_not_ssl: false, valid_status_codes: [200, 301, 302, 401, 403], headers: { User-Agent: somsiad-blackbox/1.0 } } }, http_ready: { prober: http, timeout: 5s, http: { preferred_ip_protocol: ip4, valid_status_codes: [200], fail_if_body_not_matches_regexp: ['\"status\":\"ok\"'], headers: { User-Agent: somsiad-blackbox/1.0 } } } } }"

  target {
    name    = "mooncraft"
    address = "https://mooncraft.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "mooncraft" }
  }
  target {
    name    = "abyss"
    address = "https://abyss.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "abyss" }
  }
  target {
    name    = "sribia"
    address = "https://sribia.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "sribia" }
  }
  target {
    name    = "instagrain"
    address = "https://insta.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "instagrain" }
  }
  target {
    name    = "monitoring"
    address = "https://monitoring.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "monitoring" }
  }
  // fossil + depot migrated to the Air (2026-08-20) — probed like the other
  // local services now (tunnel path, lenient module), not as external sites.
  target {
    name    = "fossil"
    address = "https://fossil.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "fossil" }
  }
  target {
    name    = "depot"
    address = "https://depot.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "depot" }
  }
  target {
    name    = "dice"
    address = "https://dice.kelostrada.pl/login"
    module  = "http_2xx"
    labels  = { target = "dice" }
  }
  target {
    name    = "api"
    address = "https://api.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "api" }
  }
  target {
    name    = "blog-wakacje"
    address = "https://blog-wakacje.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "blog-wakacje" }
  }
  target {
    name    = "melinakrzemowa"
    address = "https://melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "melinakrzemowa" }
  }

  // kelostrada.pl (PrestaShop) — on the Air since 2026-08-20 like everything
  // else.
  target {
    name    = "kelostrada"
    address = "https://kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "kelostrada" }
  }

  // tibiantis.net — migrated from seohost 2026-08-30.
  target {
    name    = "tibiantis"
    address = "https://tibiantis.net"
    module  = "http_2xx"
    labels  = { target = "tibiantis" }
  }

  // cardfight.pl — migrated from seohost 2026-08-30.
  target {
    name    = "cardfight"
    address = "https://cardfight.pl"
    module  = "http_2xx"
    labels  = { target = "cardfight" }
  }

  // Ente (self-hosted photos), added 2026-09-17. Four hostnames; the two
  // back-end ones are probed at real health endpoints rather than "/", which
  // returns 404 (museum has no route there) and 403 (MinIO refuses an
  // unauthenticated bucket listing). A 403 would pass the lenient module but
  // then trip ProbeChallenged, which is meant to catch edge-served challenges.
  target {
    name    = "ente-photos"
    address = "https://photos.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "ente-photos" }
  }
  target {
    name    = "ente-albums"
    address = "https://album.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "ente-albums" }
  }
  target {
    name    = "ente-api"
    address = "https://photos-api.kelostrada.pl/ping"
    module  = "http_2xx"
    labels  = { target = "ente-api" }
  }
  target {
    name    = "ente-s3"
    address = "https://photos-s3.kelostrada.pl/minio/health/live"
    module  = "http_2xx"
    labels  = { target = "ente-s3" }
  }

  // aniasienudzi, added 2026-09-29. Probed at /readyz, which answers 503
  // when the database is unreachable or a migration is pending, so
  // ServiceDown covers "site down" and "database down" alike.
  target {
    name    = "aniasienudzi"
    address = "https://ania.kelostrada.pl/readyz"
    module  = "http_ready"
    labels  = { target = "aniasienudzi" }
  }

  // The Pi (192.168.0.140) is NOT reached from here — Colima's Docker VM
  // sits on a NAT subnet that can reach the internet but not LAN peers.
  // Air → Pi reachability is checked by air-watchdog.{py,sh} via launchd
  // running natively on macOS. See scripts/air_watchdog.py.
}

prometheus.scrape "blackbox" {
  targets    = prometheus.exporter.blackbox.public_http.targets
  forward_to = [prometheus.remote_write.local.receiver]
  // 30s keeps decent resolution for the dashboards; the 2m ServiceDown
  // window sees plenty of samples. Timeout just needs headroom over the
  // module's 5s probe timeout.
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// =============================================================================
// METRICS — Colima VM memory. Every container shares the one Colima VM, which
// has no swap. /proc/meminfo is VM-wide even inside this container, so the
// embedded node exporter with only the meminfo collector reports the VM's
// MemAvailable (the ColimaMemoryLow alert). The macOS host itself is the
// separate node_exporter job "host" in prometheus.yml.
// =============================================================================

prometheus.exporter.unix "colima" {
  set_collectors = ["meminfo"]
}

discovery.relabel "colima" {
  targets = prometheus.exporter.unix.colima.targets

  rule {
    target_label = "job"
    replacement  = "colima"
  }
  rule {
    target_label = "instance"
    replacement  = "colima-vm"
  }
}

prometheus.scrape "colima" {
  targets         = discovery.relabel.colima.output
  forward_to      = [prometheus.remote_write.local.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
