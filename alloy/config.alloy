// =============================================================================
// LOGS — discover all docker containers and ship their stdout/stderr to Loki
// =============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Drop our own monitoring containers from log collection (they're noisy and
  // we'd be storing their logs in Loki, which generates more logs, etc.)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(grafana|prometheus|loki|tempo|alloy)"
    action        = "drop"
  }

  // Use the container name (minus leading /) as the loki "container" label.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Best-effort: tag a 'service' label by stripping the docker-compose suffix.
  // e.g. instamelinakrzemowapl-web-1 -> instagrain
  //      sribiamelinakrzemowapl-db-1 -> sribia-db
  //      mooncraft -> mooncraft
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-web-.*"
    target_label  = "service"
    replacement   = "instagrain"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-db-.*"
    target_label  = "service"
    replacement   = "instagrain-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/insta.*-minio.*"
    target_label  = "service"
    replacement   = "instagrain-minio"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/sribia.*-web-.*"
    target_label  = "service"
    replacement   = "sribia"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/sribia.*-db-.*"
    target_label  = "service"
    replacement   = "sribia-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/mooncraft"
    target_label  = "service"
    replacement   = "mooncraft"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/abyss"
    target_label  = "service"
    replacement   = "abyss"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-web-.*"
    target_label  = "service"
    replacement   = "fossil"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-db-.*"
    target_label  = "service"
    replacement   = "fossil-db"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fossil.*-cron-.*"
    target_label  = "service"
    replacement   = "fossil-cron"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
  refresh_interval = "30s"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// =============================================================================
// TRACES — receive OTLP from apps, batch, ship to Tempo
// =============================================================================

otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// =============================================================================
// METRICS — Blackbox (HTTP probes). Per-container metrics come from a
// dedicated cAdvisor service (see docker-compose.yml); Prometheus scrapes
// it directly via its own scrape_config.
// =============================================================================

prometheus.exporter.blackbox "public_http" {
  // http_2xx accepts 401/403 because some targets sit behind Cloudflare Access.
  // http_2xx_strict does NOT: for plain public sites a 403 usually means a
  // Cloudflare WAF challenge is answering instead of the origin, and we want
  // that to count as DOWN rather than silently probing the challenge page.
  // The custom User-Agent gives Cloudflare WAF skip-rules something to match.
  // Its 20s timeout (vs 5s) is deliberate. Root cause, measured over one
  // 12h window: the kelostrada origin (seohost shared hosting) gets slow
  // every night. Failures are NOT network and NOT Cloudflare — the resolve,
  // connect, tls and transfer phases stay sub-100ms throughout. Only the
  // `processing` phase (TTFB, i.e. the origin generating a response) blows
  // up: p95 ~0.6-2.3s during the day, but 4.3-6.7s between 22:00-01:00
  // local, with individual samples past 9s. ~85% of all probe failures fell
  // in that 3-hour window. Every failure was probe_duration pinned at
  // exactly 9.00s with http_status_code=0 — the old timeout firing, never a
  // real error response. fossil and kelostrada fail on the same samples
  // (22 of 30) because they share one origin / one Cloudflare zone.
  // 5s flapped, 9s still clipped the nightly tail, 20s clears it.
  // Must stay under scrape_timeout below.
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { preferred_ip_protocol: ip4, fail_if_not_ssl: false, valid_status_codes: [200, 301, 302, 401, 403] } }, http_2xx_strict: { prober: http, timeout: 20s, http: { preferred_ip_protocol: ip4, fail_if_not_ssl: false, valid_status_codes: [200, 301, 302], headers: { User-Agent: somsiad-blackbox/1.0 } } } } }"

  target {
    name    = "mooncraft"
    address = "https://mooncraft.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "mooncraft" }
  }
  target {
    name    = "abyss"
    address = "https://abyss.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "abyss" }
  }
  target {
    name    = "sribia"
    address = "https://sribia.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "sribia" }
  }
  target {
    name    = "instagrain"
    address = "https://insta.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "instagrain" }
  }
  target {
    name    = "monitoring"
    address = "https://monitoring.melinakrzemowa.pl"
    module  = "http_2xx"
    labels  = { target = "monitoring" }
  }
  // fossil migrated to the Air (2026-08-20) — probed like the other local
  // services now (tunnel path, lenient module), not as an external site.
  target {
    name    = "fossil"
    address = "https://fossil.kelostrada.pl"
    module  = "http_2xx"
    labels  = { target = "fossil" }
  }

  // Bartosz's external sites (hosted elsewhere, behind Cloudflare proxy).
  // Strict module: a CF challenge page (403) must count as down.
  target {
    name    = "kelostrada"
    address = "https://kelostrada.pl"
    module  = "http_2xx_strict"
    labels  = { target = "kelostrada" }
  }

  // The Pi (192.168.0.140) is NOT reached from here — Colima's Docker VM
  // sits on a NAT subnet that can reach the internet but not LAN peers.
  // Air → Pi reachability is checked by air-watchdog.{py,sh} via launchd
  // running natively on macOS. See scripts/air_watchdog.py.
}

prometheus.scrape "blackbox" {
  targets    = prometheus.exporter.blackbox.public_http.targets
  forward_to = [prometheus.remote_write.local.receiver]
  // 30s keeps decent resolution for the dashboards; the alert windows
  // (2m ServiceDown, 5m KelostradaSiteDown) each see plenty of samples.
  // scrape_timeout must exceed the 20s strict-module probe timeout and stay
  // under scrape_interval.
  scrape_interval = "30s"
  scrape_timeout  = "25s"
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
