{
  "title": "Somsiad — Static Site",
  "uid": "somsiad-static",
  "tags": ["somsiad", "static"],
  "description": "Per-site overview for the static (no-app-metrics) services. Pick a target from the dropdown.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "target",
        "label": "Site",
        "query": "mooncraft,abyss,fossil,kelostrada",
        "options": [
          { "text": "mooncraft",  "value": "mooncraft",  "selected": true },
          { "text": "abyss",      "value": "abyss",      "selected": false },
          { "text": "fossil",     "value": "fossil",     "selected": false },
          { "text": "kelostrada", "value": "kelostrada", "selected": false }
        ],
        "current": { "text": "mooncraft", "value": "mooncraft" },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{target=\"$target\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Probe latency",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_duration_seconds{target=\"$target\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "TLS cert expiry",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(probe_ssl_earliest_cert_expiry{target=\"$target\"} - time()) / 86400", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "days",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 14 },
            { "color": "green", "value": 30 }
          ]}
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probe latency over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_duration_seconds{target=\"$target\"}", "legendFormat": "duration", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service=\"$target\"}", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
