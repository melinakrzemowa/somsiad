{
  "title": "Phoenix App",
  "uid": "somsiad-phoenix",
  "tags": ["somsiad", "phoenix"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=~\"instagrain|sribia|aniasienudzi\"}, job)",
        "refresh": 1,
        "current": { "text": "instagrain", "value": "instagrain" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"$service\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Req/sec",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(phoenix_http_request_duration_milliseconds_count{job=\"$service\"}[5m]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(phoenix_http_request_duration_milliseconds_count{job=\"$service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(phoenix_http_request_duration_milliseconds_count{job=\"$service\"}[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]}
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket{job=\"$service\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(phoenix_http_request_duration_milliseconds_count{job=\"$service\"}[2m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BEAM memory (MB)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "beam_memory_atom_total_bytes{job=\"$service\"} / 1024 / 1024", "legendFormat": "atom", "refId": "A" },
        { "expr": "beam_memory_processes_total_bytes{job=\"$service\"} / 1024 / 1024", "legendFormat": "processes", "refId": "B" },
        { "expr": "beam_memory_binary_total_bytes{job=\"$service\"} / 1024 / 1024", "legendFormat": "binary", "refId": "C" },
        { "expr": "beam_memory_ets_total_bytes{job=\"$service\"} / 1024 / 1024", "legendFormat": "ets", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service=\"$service\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Oban: jobs waiting to run (by queue)",
      "description": "Available (ready, not started) jobs per queue. Apps without Oban show no data.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (queue) (oban_queue_length_count{job=\"$service\", state=\"available\"})", "legendFormat": "{{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Oban: jobs finished per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (queue, state) (rate(oban_job_processing_duration_milliseconds_count{job=\"$service\"}[5m])) * 60", "legendFormat": "{{queue}} {{state}}", "refId": "A" },
        { "expr": "sum by (queue) (rate(oban_job_exception_duration_milliseconds_count{job=\"$service\"}[5m])) * 60", "legendFormat": "{{queue}} exception", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Oban: job wait before start, p95",
      "description": "Time from scheduled to started. The histogram's top bucket is 20 s, so anything slower reads as 20 s.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (queue, le) (rate(oban_job_queue_time_milliseconds_bucket{job=\"$service\"}[15m])))", "legendFormat": "{{queue}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Container memory: working set vs limit (MB)",
      "description": "cAdvisor, joined to container names through docker_container_info. Only apps whose containers get a service label in prometheus.yml (docker-names job) show data.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (name) (container_memory_working_set_bytes{container_id!=\"\"} * on (container_id) group_left(name) docker_container_info{service=~\"$service|$service-db\"}) / 1024 / 1024", "legendFormat": "{{name}}", "refId": "A" },
        { "expr": "sum by (name) (container_spec_memory_limit_bytes{container_id!=\"\"} * on (container_id) group_left(name) docker_container_info{service=~\"$service|$service-db\"}) / 1024 / 1024", "legendFormat": "{{name}} limit", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    }
  ]
}
