{
  "title": "Somsiad — Host",
  "uid": "somsiad-host",
  "tags": ["somsiad", "host"],
  "description": "Whole-host metrics from node_exporter running on the macOS host (host.docker.internal:9100).",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "time() - node_boot_time_seconds{job=\"host\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU usage",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(1 - avg(rate(node_cpu_seconds_total{job=\"host\",mode=\"idle\"}[2m]))) * 100", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory used",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(node_memory_active_bytes{job=\"host\"} + node_memory_wired_bytes{job=\"host\"} + node_memory_compressed_bytes{job=\"host\"}) / node_memory_total_bytes{job=\"host\"} * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 75 },
            { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Load (1m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "node_load1{job=\"host\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 6 },
            { "color": "red", "value": 12 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by mode (% of all cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "avg by (mode) (rate(node_cpu_seconds_total{job=\"host\",mode!=\"idle\"}[2m])) * 100",
        "legendFormat": "{{mode}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory breakdown",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_memory_wired_bytes{job=\"host\"}", "legendFormat": "wired", "refId": "A" },
        { "expr": "node_memory_active_bytes{job=\"host\"}", "legendFormat": "active", "refId": "B" },
        { "expr": "node_memory_compressed_bytes{job=\"host\"}", "legendFormat": "compressed", "refId": "C" },
        { "expr": "node_memory_inactive_bytes{job=\"host\"}", "legendFormat": "inactive", "refId": "D" },
        { "expr": "node_memory_purgeable_bytes{job=\"host\"}", "legendFormat": "purgeable", "refId": "E" },
        { "expr": "node_memory_free_bytes{job=\"host\"}", "legendFormat": "free", "refId": "F" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Load average",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_load1{job=\"host\"}",  "legendFormat": "1m",  "refId": "A" },
        { "expr": "node_load5{job=\"host\"}",  "legendFormat": "5m",  "refId": "B" },
        { "expr": "node_load15{job=\"host\"}", "legendFormat": "15m", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Filesystem usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(1 - node_filesystem_avail_bytes{job=\"host\",mountpoint=~\"/|/System/Volumes/Data\"} / node_filesystem_size_bytes{job=\"host\",mountpoint=~\"/|/System/Volumes/Data\"}) * 100",
        "legendFormat": "{{mountpoint}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 75 },
            { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Network throughput (en0)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{job=\"host\",device=\"en0\"}[2m]) * 8",  "legendFormat": "rx", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{job=\"host\",device=\"en0\"}[2m]) * 8", "legendFormat": "tx", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk I/O (disk0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total{job=\"host\",device=\"disk0\"}[2m])",    "legendFormat": "read",  "refId": "A" },
        { "expr": "rate(node_disk_written_bytes_total{job=\"host\",device=\"disk0\"}[2m])", "legendFormat": "write", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Battery charge",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "node_power_supply_current_capacity{job=\"host\"} / node_power_supply_max_capacity{job=\"host\"} * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 25 },
            { "color": "green", "value": 60 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Power source",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "node_power_supply_power_source_state{job=\"host\"} == 1", "legendFormat": "{{state}}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Battery health",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "node_power_supply_battery_health{job=\"host\"} == 1", "legendFormat": "{{state}}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Charging?",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "node_power_supply_charging{job=\"host\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no", "color": "blue" } } },
            { "type": "value", "options": { "1": { "text": "yes", "color": "green" } } }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    }
  ]
}
